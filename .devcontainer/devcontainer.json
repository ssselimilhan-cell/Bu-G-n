{
  "name": "BUGUN Flutter Android",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" },
    "ghcr.io/itsmechlark/features/flutter:1": {}
  },
  "postCreateCommand": "flutter --version && flutter pub get",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  },
  "remoteUser": "vscode"
}
